# Copy to project root as .env  (NEVER commit the real .env — it is gitignored)

# --- data sources (most have free tiers; optional ones degrade gracefully) ---
HELIUS_API_KEY=
# Optional: free-tier hosted Llama (console.groq.com) for the web AI analyst when you deploy publicly and
# can't self-host Ollama on a GPU. Leave EMPTY for local dev — the analyst uses your local Ollama instead.
GROQ_API_KEY=
RUGCHECK_API_KEY=
TWEETSCOUT_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
CIELO_API_KEY=

# --- LIVE TRADING ONLY — leave BOTH empty to stay in paper mode ---
# Live requires this set to 1 AND config execution.mode=live (two independent flags).
SOLSCOUT_ALLOW_LIVE=
# Dedicated low-balance HOT wallet. NEVER paste your main wallet key here.
HOT_WALLET_PRIVATE_KEY=
